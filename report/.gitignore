# Ignorer les rapports compilés (HTML, PDF et Markdown intermédiaires)
*.html
*.pdf
*.md

# Ignorer les répertoires auxiliaires de style (CSS, JS) et caches Quarto
*_files/
*_cache/
.quarto/

# Fichiers de notebooks compilés
notebooks/*.qmd

# Assets générés du rapport et du dashboard
assets/*.html
assets/*.png
!assets/.gitkeep

# Conserver les fichiers sources importants
!rapport.qmd
!sujet.qmd
!references.bib
!assets/
